# Copy this file to secrets.yaml and fill in your values.
# See https://esphome.io/guides/faq.html#tips-for-using-esphome

wifi_ssid: "your_wifi_ssid"
wifi_password: "your_wifi_password"
ota_password: "your_ota_password"
ap_password: "your_ap_password"

# Only needed for API encryption (native HA integration)
# api_key: "generate_with_esphome"

# Only needed for MQTT data source (openeth-mqtt.yaml)
# panasonic_aquarea_mqtt_host: "192.168.1.100"
# panasonic_aquarea_mqtt_port: "1883"
# panasonic_aquarea_mqtt_username: "mqtt_user"
# panasonic_aquarea_mqtt_password: "mqtt_password"
